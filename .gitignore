# 本地运行配置（默认模板保留在 asset/ 中）
/config.json
/modpath.json
.env
.env.*
!.env.example
!.env.sample

# API 配置与用户安装的 MOD：保留目录占位文件
/api/*
!/api/.gitkeep
/petmod/*
!/petmod/.gitkeep

# Python 虚拟环境与缓存
/.venv/
/venv/
/env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
/htmlcov/

# 构建、打包产物与本地打包配置
/AIDesktopPet.spec
/build/
/dist/
*.egg-info/
PyInstaller.txt

# 本机编辑器配置与临时脚本
/.vscode/
/.idea/
/tempCodeRunnerFile.py
*.swp
*.swo
*~

# 日志、原子写入残留及备份
*.log
*.tmp
*.bak

# 操作系统生成文件
.DS_Store
Thumbs.db
Desktop.ini
